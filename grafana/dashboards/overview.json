{
 "uid": "gw-overview",
 "title": "Claude gateway: overview",
 "tags": [
  "claude",
  "gateway"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "graphTooltip": 1,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "data",
    "label": "Data",
    "type": "custom",
    "query": "all,real,loadtest",
    "current": {
     "text": "all",
     "value": "all"
    },
    "options": [
     {
      "text": "all",
      "value": "all",
      "selected": true
     },
     {
      "text": "real",
      "value": "real",
      "selected": false
     },
     {
      "text": "loadtest",
      "value": "loadtest",
      "selected": false
     }
    ],
    "description": "real = calls that went to the model provider. loadtest = canned replies from load_test_mode."
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Requests",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT count() FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test))",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "All calls that reached /v1/messages, from the gateway audit log."
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Success rate",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 4,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT round(100*countIf(outcome='ok')/greatest(count(),1),1) FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test))",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#0ca30c"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#0ca30c",
        "value": null
       }
      ]
     },
     "unit": "percent",
     "decimals": 1
    },
    "overrides": []
   },
   "description": "Share of requests that returned < 400. Includes rejections and upstream errors in the denominator."
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p95 latency (OK)",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 8,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT round(quantileIf(0.95)(latency_ms, outcome='ok')) FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test))",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "ms"
    },
    "overrides": []
   },
   "description": "Gateway-measured time for successful requests. Load-test replies skip the model, so they read near zero."
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Active users",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT uniqExact(email) FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test)) AND email != ''",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   }
  },
  {
   "id": 5,
   "type": "stat",
   "title": "Upstream errors",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 16,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT countIf(outcome='upstream_error') FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test))",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#d03b3b"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#d03b3b",
        "value": null
       }
      ]
     }
    },
    "overrides": []
   },
   "description": "Model-provider failures (quota, permission, not found, 5xx)."
  },
  {
   "id": 6,
   "type": "stat",
   "title": "Spend this month",
   "datasource": {
    "type": "postgres",
    "uid": "gateway-pg"
   },
   "gridPos": {
    "x": 20,
    "y": 0,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "gateway-pg"
     },
     "rawSql": "SELECT coalesce(sum(cents),0)/100 FROM spend WHERE period = to_char(now() at time zone 'utc','YYYY-MM')",
     "format": "table"
    }
   ],
   "options": {
    "colorMode": "none",
    "graphMode": "none",
    "textMode": "value",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "color": {
      "mode": "fixed",
      "fixedColor": "#3987e5"
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "#3987e5",
        "value": null
       }
      ]
     },
     "unit": "currencyUSD"
    },
    "overrides": []
   },
   "description": "From the gateway ledger (list-price estimate, a guardrail not an invoice). Reads $0 until real model calls are metered; load-test replies are not billed."
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Requests over time by outcome",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 16,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT toStartOfInterval(ts, toIntervalSecond(greatest($__interval_s, 60))) AS time, multiIf(outcome='ok','OK',outcome='rejected','Rejected by gateway',outcome='spend_cap','Spend cap','Upstream error') AS outcome, count() AS requests FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test)) GROUP BY time, outcome ORDER BY time",
     "format": 0,
     "editorType": "sql",
     "queryType": "timeseries"
    }
   ],
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi",
     "sort": "desc"
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "drawStyle": "bars",
      "fillOpacity": 85,
      "lineWidth": 0,
      "barAlignment": 0,
      "gradientMode": "none",
      "stacking": {
       "mode": "normal",
       "group": "A"
      },
      "axisBorderShow": false,
      "showPoints": "never",
      "spanNulls": false
     },
     "color": {
      "mode": "palette-classic-by-name"
     },
     "unit": "short",
     "min": 0,
     "displayName": "${__field.labels.outcome}"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "OK"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#0ca30c"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Rejected by gateway"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#fab219"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Spend cap"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#ec835a"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "Upstream error"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d03b3b"
        }
       }
      ]
     }
    ]
   },
   "description": "Colour = outcome (status palette). Stacked so the total is total traffic."
  },
  {
   "id": 8,
   "type": "bargauge",
   "title": "Requests by model",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 9
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT if(model='','(none)',model) AS model, count() AS requests FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test)) GROUP BY model ORDER BY requests DESC",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "orientation": "horizontal",
    "displayMode": "basic",
    "valueMode": "color",
    "showUnfilled": true,
    "namePlacement": "top",
    "minVizHeight": 16,
    "minVizWidth": 8,
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ],
     "values": false
    },
    "legend": {
     "showLegend": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "min": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#6b6a65"
     },
     "unit": "short"
    },
    "overrides": [
     {
      "matcher": {
       "id": "byName",
       "options": "claude-opus-4-8"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "claude-sonnet-4-6"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#d95926"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "claude-haiku-4-5-20251001"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#199e70"
        }
       }
      ]
     },
     {
      "matcher": {
       "id": "byName",
       "options": "claude-haiku-5-5"
      },
      "properties": [
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#c98500"
        }
       }
      ]
     }
    ]
   },
   "description": "Count per model, same colours as every other chart. (none) = rejected before a model was chosen.",
   "transformations": [
    {
     "id": "rowsToFields",
     "options": {
      "mappings": [
       {
        "fieldName": "model",
        "handlerKey": "field.name"
       },
       {
        "fieldName": "requests",
        "handlerKey": "field.value"
       }
      ]
     }
    }
   ]
  },

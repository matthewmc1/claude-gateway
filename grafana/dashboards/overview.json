  {
   "id": 12,
   "type": "table",
   "title": "Usage by user and model",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 12,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT if(email='','(unauthenticated)',email) AS user, if(model='','(none)',model) AS model, count() AS requests,\n      round(100*countIf(outcome='ok')/count(),1) AS success_pct, if(countIf(outcome='ok')=0, NULL, round(quantileIf(0.95)(latency_ms,outcome='ok'))) AS p95_ms\n      FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test)) GROUP BY user, model ORDER BY requests DESC",
     "format": 1,
     "editorType": "sql",
     "queryType": "table"
    }
   ],
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false
    }
   },
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      }
     }
    },

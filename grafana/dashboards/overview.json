        "value": {
         "type": "gauge",
         "mode": "basic"
        }
       },
       {
        "id": "min",
        "value": 0
       },
       {
        "id": "max",
        "value": 100
       },
       {
        "id": "color",
        "value": {
         "mode": "fixed",
         "fixedColor": "#3987e5"
        }
       }
      ]
     }
    ]
   },
   "description": "Who is using which model, and how well it is working for them. This is the optimisation view."
  },
  {

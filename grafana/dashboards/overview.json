     "refId": "A",
     "datasource": {
      "type": "postgres",
      "uid": "gateway-pg"
     },
     "rawSql": "SELECT coalesce(e.email, s.principal) AS \"user\", round((s.cents/100)::numeric,4) AS usd\n     FROM spend s LEFT JOIN principal_emails e ON e.principal = s.principal\n     WHERE s.period = to_char(now() at time zone 'utc','YYYY-MM') ORDER BY s.cents DESC",
     "format": "table"

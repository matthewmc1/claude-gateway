  {
   "id": 11,
   "type": "timeseries",
   "title": "Latency p50 / p95 (OK requests)",
   "datasource": {
    "type": "grafana-clickhouse-datasource",
    "uid": "clickhouse"
   },
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "grafana-clickhouse-datasource",
      "uid": "clickhouse"
     },
     "rawSql": "SELECT toStartOfInterval(ts, toIntervalSecond(greatest($__interval_s, 60))) AS time, round(quantile(0.5)(latency_ms)) AS p50, round(quantile(0.95)(latency_ms)) AS p95 FROM otel.v_gateway_requests WHERE $__timeFilter(ts) AND ('$data' = 'all' OR ('$data' = 'real' AND NOT is_load_test) OR ('$data' = 'loadtest' AND is_load_test)) AND outcome='ok' GROUP BY time ORDER BY time",
     "format": 0,
     "editorType": "sql",
     "queryType": "timeseries"
    }
   ],
   "options": {
    "legend": {
     "showLegend": true,
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {

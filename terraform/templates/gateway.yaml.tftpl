# Rendered by Terraform into Secret Manager (claude-gateway-config). Do not edit by hand; change variables and apply.
# $${VAR} references are filled by the gateway at boot from Cloud Run secrets.
listen:
  host: 0.0.0.0
  port: 8080
  public_url: ${public_url}
  trusted_proxies: [169.254.0.0/16]

oidc:
  issuer: ${oidc_issuer}
  client_id: ${oidc_client_id}
  client_secret: $${OIDC_CLIENT_SECRET}
  allowed_email_domains: [${join(", ", allowed_email_domains)}]
  scopes: [openid, profile, email]
  extra_auth_params: { access_type: offline, prompt: consent }

session:
  jwt_secret: $${GATEWAY_JWT_SECRET}
  ttl_hours: 1

store:
  postgres_url: $${GATEWAY_POSTGRES_URL}

upstreams:
  - provider: vertex
    region: ${vertex_region}
    project_id: ${project_id}
    auth: {}

auto_include_builtin_models: true

# One write key per admin: the gateway's audit trail records "admin-key:<email>" for every cap change.
admin:
  write_keys:
%{ for a in admins ~}
    - { id: "${a.email}", key: "${a.key}" }
%{ endfor ~}
  read_keys:
    - { id: budget-app-read, key: "$${GATEWAY_ADMIN_READ_KEY}" }
  blocked_message: "Spend cap reached. Ask the platform team for an increase."

managed:
  policies:
    - match: {}
      code:
        enforceAvailableModels: true
        availableModels: [${join(", ", allowed_models)}]

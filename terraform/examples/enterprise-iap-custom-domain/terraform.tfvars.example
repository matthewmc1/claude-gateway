# Enterprise edge with a custom domain for the budget app (global external Application Load Balancer, IAP on its backend
# service) and the private internal load balancer for the gateway. Copy to ../../terraform.tfvars.
project_id            = "my-gateway-project"
profile               = "production"
app_image_tag         = "20261013093000" # the tag deploy/build-push.sh prints
admin_users           = [{ email = "platform-lead@example.com", name = "Platform Lead" }]
allowed_email_domains = ["example.com"]
oidc                  = { client_id = "123456789012-abcdef123456.apps.googleusercontent.com" } # or leave out until the client exists

app_access  = "iap"
app_domain  = "claude-budget.example.com" # A record -> terraform output app_lb_ip
app_viewers = ["group:engineering@example.com"]
# After creating the OAuth client in the console (edge_next_steps):
# iap_oauth_client_id = "123456789012-iapclient.apps.googleusercontent.com"
# iap_oauth_client_secret: set TF_VAR_iap_oauth_client_secret, never in this file

gateway_exposure = "internal_lb"
gateway_hostname = "claude-gateway.corp.example.com"
